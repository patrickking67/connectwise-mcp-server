{
  "name": "connectwise-mcp-server",
  "version": "0.2.0",
  "description": "Unified ConnectWise MCP server (PSA/Manage, Automate, Control) \u2014 local stdio, remote Streamable HTTP, and an MCPB bundle",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contract": "node scripts/check-repo-contract.mjs",
    "dev": "tsx watch src/index.ts",
    "docker:build": "docker build -t connectwise-mcp-server .",
    "mcpb:pack": "npm run build && mcpb pack . connectwise-mcp-server.mcpb",
    "mcpb:validate": "mcpb validate manifest.json",
    "start": "node dist/index.js",
    "start:remote": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "jose": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "bin": {
    "connectwise-mcp-server": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Patrick King"
  }
}
